# Whitelist-only: ignore everything except *.md, *.py, *.vac, *.json, *.cs, *.cslist,
# *.txt, and *.jpg only under Saves/scene/ (any subfolder depth).
# Under Custom/, only Custom/Scripts/ may contain trackable files; other Custom/
# subtrees stay ignored while extension rules apply elsewhere as before.
# (`*` ignores; `!*/` lets Git traverse directories so `!` rules can match.)
*
!*/
!.gitignore
!**/*.md
!**/*.py
/Saves/
!**/*.vac
!**/*.json
!**/*.cs
!**/*.cslist
!**/*.txt
menu_tools/
Custom/Scripts/VAMDeluxe/Dollmaster/
Assets/

# Custom/: only those extensions under Scripts/ (not e.g. .wav); **/ traverses nested folders.
Custom/**
!Custom/Scripts/
!Custom/Scripts/**/
!Custom/Scripts/**/*.md
!Custom/Scripts/**/*.py
!Custom/Scripts/**/*.vac
!Custom/Scripts/**/*.json
!Custom/Scripts/**/*.cs
!Custom/Scripts/**/*.cslist
!Custom/Scripts/**/*.txt
!Custom/Scripts/ceq3/MorphMAS/MorphMAS.csproj

# Cursor: Gabriel agent rules (`.mdc` is not in the global extension list above).
!.cursor/
!.cursor/rules/
!.cursor/rules/gabriel-*.mdc

# After whitelist: hide paths whose components contain these substrings (case variants).
# Later rules win; * does not cross '/' so each path segment is checked.
*pose*
*Pose*
!Custom/Scripts/Easy Mate/src/EasyMateVrEulerPossessPoseCheck.cs
!Custom/Scripts/Gabriel/features/palm-hud/VrEulerPossessPoseCheck.cs
*appearance*
*Appearance*

# Large Saves/scene assets — explicit excludes (later than *.json / *.vac whitelist above).
/Saves/scene/X_Duke/Gang Blowjob/Sheryn_Gang Blowjob_anima.json
/Saves/scene/_My Scenes/20 Minute Mocap Patreon.json
/Saves/scene/sapuzex/rainy night revenge/20 Minute Mocap Patreon.json
/Saves/scene/1593832244.json
